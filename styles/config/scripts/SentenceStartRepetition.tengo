// Source: vale-ai-tells v1.37.0 (MIT).
// Changed: Articles do not count as openers.
text := import("text")

matches := []

// The script measures each section under a Markdown heading on its own.
sections := text.re_split(`(?m)^#{1,6}\s+[^\n]+\n`, scope)

for section in sections {
    section = text.trim_space(section)
    if section == "" {
        continue
    }

    // Remove code blocks and HTML comments from a copy. The section keeps its
    // text for the position of the alert.
    clean := text.join(text.re_split("(?s)```.*?```", section, -1), "")
    clean = text.join(text.re_split("<!--.*?-->", clean, -1), "")
    // Remove MDX comments and expression lines, import and export statements,
    // front matter, and JSX or HTML tags with their attributes. Otherwise a
    // component tag reads as the first word of the next sentence. A
    // self-closing tag on a line of its own then reads as a paragraph.
    clean = text.join(text.re_split(`(?s)\{/\*.*?\*/\}`, clean, -1), "")
    clean = text.join(text.re_split(`(?m)^[ \t]*(?:import|export)\b[^\n]*$`, clean, -1), "")
    clean = text.join(text.re_split(`(?s)\A---\n.*?\n---(?:\n|\z)`, clean, -1), "")
    clean = text.join(text.re_split(`(?s)</?[A-Za-z][A-Za-z0-9.:-]*(?:\s[^<>]*?)?/?>`, clean, -1), "")
    clean = text.join(text.re_split(`(?m)^[ \t]*\{[^\n]*\}[ \t]*$`, clean, -1), "")

    // Skip a list item, a table row and the other lines that are not prose.
    lines := text.split(clean, "\n")
    prose_lines := []
    for line in lines {
        trimmed := text.trim_space(line)
        if text.has_prefix(trimmed, "- ") || text.has_prefix(trimmed, "* ") || text.has_prefix(trimmed, "1.") {
            continue
        }
        if text.has_prefix(trimmed, "- [") {
            continue
        }
        if text.has_prefix(trimmed, "|") {
            continue
        }
        prose_lines = append(prose_lines, line)
    }
    clean = text.join(prose_lines, "\n")

    // Join the lines before the split into sentences.
    flat := text.join(text.fields(clean), " ")

    if flat == "" {
        continue
    }

    sentences := text.re_split(`[.!?]+\s+`, flat)

    // Count the first word of each sentence in the section.
    first_words := {}
    total := 0
    for s in sentences {
        trimmed := text.trim_space(s)
        if trimmed != "" {
            words := text.re_split(`\s+`, trimmed)
            if len(words) > 0 {
                word := text.to_lower(words[0])
                // Skip the articles ASD-STE100 rule 4.5 puts before
                // nouns, and single-character words.
                if len(word) >= 2 && word != "the" && word != "an" {
                    if first_words[word] == undefined {
                        first_words[word] = 0
                    }
                    first_words[word] += 1
                    total += 1
                }
            }
        }
    }

    // A section needs 6 sentences.
    if total >= 6 {
        // Flag the section when one first word opens more than 30% of its
        // sentences, and at least 3 of them.
        for word, count in first_words {
            ratio := (0.0 + count) / total
            if ratio > 0.30 && count >= 3 {
                start := text.index(scope, section)
                if start < 0 {
                    start = 0
                }
                end := start + len(section)
                if end > len(scope) {
                    end = len(scope)
                }
                matches = append(matches, {begin: start, end: end})
                break
            }
        }
    }
}
